# Stop EditorConfig search at the repository root and use tool defaults
root = true

[*.cs]
# Flag unnecessary using directives so `dotnet format` removes them automatically
dotnet_diagnostic.IDE0005.severity = warning
dotnet_sort_system_directives_first = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
